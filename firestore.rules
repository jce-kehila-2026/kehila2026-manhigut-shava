rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Helpers ── */
    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    /* ── Data validation helpers ── */
    function hasFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    function isNonEmptyString(val) {
      return val is string && val.size() > 0;
    }

    /* ── Users ── */
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin()
        || (isAuth() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['networksCount', 'isMentor', 'isMentee']));

      /* Private contact PII (phone/email). The public user-doc read above is
         available to every signed-in member, so contact must NOT live there.
         It is kept in this subcollection, readable only by the owner or an
         admin — matching the privacy promise that contact stays hidden from
         other graduates. (Frontend is moved onto this in tasks 5b/5c.) */
      match /private/{docId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      /* Birthday wishes — any signed-in user can send a wish; only the
         sender or an admin can delete it. */
      match /birthdayWishes/{wishId} {
        allow read:   if isAuth();
        allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
        allow delete: if isAuth() && (resource.data.fromUserId == request.auth.uid || isAdmin());
      }
    }

    /* ── Posts ── */
    match /posts/{postId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.authorId == request.auth.uid
        && hasFields(['authorId', 'createdAt'])
        && isNonEmptyString(request.resource.data.authorId);
      allow update: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likesCount', 'likedBy', 'commentCount', 'isPinned', 'repostCount']));
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read:   if isAuth();
        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid
          && hasFields(['authorId', 'text', 'createdAt'])
          && isNonEmptyString(request.resource.data.text)
          && request.resource.data.text.size() <= 2000;
        allow update: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
        allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    /* ── Conversations ── */
    match /conversations/{convId} {
      allow read:   if isAuth() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && hasFields(['participants'])
        && request.resource.data.participants.size() >= 2;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read:   if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isAuth() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
          hasFields(['senderId', 'createdAt']) &&
          (isNonEmptyString(request.resource.data.text) || request.resource.data.imageUrl is string);
        allow update: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow delete: if isAuth() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    /* ── Help requests ── */
    match /helpRequests/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.fromUserId
        && hasFields(['fromUserId', 'toUserId', 'createdAt'])
        && isNonEmptyString(request.resource.data.toUserId);
      allow update: if isAuth() &&
        (request.auth.uid == resource.data.toUserId ||
         request.auth.uid == resource.data.fromUserId || isAdmin());
      allow delete: if isAuth() &&
        (request.auth.uid == resource.data.fromUserId ||
         request.auth.uid == resource.data.toUserId || isAdmin());
    }

    /* ── Networks (connection system) ── */
    match /networks/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
      allow delete: if isAuth() && resource.data.fromUserId == request.auth.uid;
    }

    /* ── Reviews ── */
    match /reviews/{reviewId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.reviewerId == request.auth.uid;
    }

    /* ── OTPs ── */
    match /otps/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    /* ── Notifications ── */
    match /notifications/{notifId} {
      allow read:   if isAuth() && resource.data.toUserId == request.auth.uid;
      /* The sender must stamp themselves as fromUserId — prevents forging a
         notification that appears to come from someone else. */
      allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuth() && (resource.data.toUserId == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.toUserId == request.auth.uid || isAdmin());
    }

    /* ── Events ── */
    match /events/{eventId} {
      allow read:   if isAuth();
      allow create: if isAdmin() && hasFields(['title', 'date', 'authorId'])
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /rsvps/{uid} {
        allow read:   if isAuth();
        allow write:  if isAuth() && isOwner(uid);
      }
    }

    /* ── Jobs ── */
    match /jobs/{jobId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    /* ── Groups ── */
    match /groups/{groupId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin()
        || request.auth.uid in resource.data.members);
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    /* ── Mentorship requests ── */
    match /mentorRequests/{reqId} {
      allow read:   if isAuth() && (resource.data.mentorId == request.auth.uid || resource.data.menteeId == request.auth.uid || isAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.mentorId == request.auth.uid || resource.data.menteeId == request.auth.uid);
      allow delete: if isAuth() && (resource.data.mentorId == request.auth.uid || resource.data.menteeId == request.auth.uid || isAdmin());
    }

    /* ── Stories ── */
    match /stories/{storyId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    /* ── Activity logs ── */
    match /activityLogs/{logId} {
      /* The actor must be the writer — stops users forging log entries that
         appear to come from someone else. (A fully tamper-proof audit trail
         would be written server-side from Cloud Functions — follow-up task.) */
      allow create: if isAuth() && request.resource.data.actorId == request.auth.uid;
      allow read:   if isAdmin();
    }

    /* ── Reports ── */
    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    /* ── Site settings (slideshow, etc.) ── */
    match /siteSettings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    /* ── Blacklist — email addresses permanently blocked from the platform ── */
    match /blacklist/{docId} {
      /* Must be readable before login/signup so the check can run unauthenticated. */
      allow read: if true;
      /* Only admins can add or remove entries. */
      allow create, delete: if isAdmin();
    }

    /* ── Custom professions (user-contributed, shared dropdown) ── */
    match /customProfessions/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
    }

    /* ── Custom institutions (user-contributed, shared dropdown) ── */
    match /customInstitutions/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
    }

    /* ── Default: deny all ── */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

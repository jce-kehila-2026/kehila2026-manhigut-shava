rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: check if the requesting user is an admin ───────────────────
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    // Any auth user can read profiles.
    // Owner can do anything to their own doc.
    // Admin can update any user's profile.
    // Any auth user can increment/decrement networksCount (connection system).
    match /users/{userId} {
      allow read:   if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId
        || isAdmin()
        || (request.auth != null &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['networksCount']));
    }

    // ─── Help requests ───────────────────────────────────────────────────────
    match /helpRequests/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.toUserId   == request.auth.uid
         || resource.data.fromUserId == request.auth.uid
         || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid
         || resource.data.toUserId   == request.auth.uid
         || isAdmin());
    }

    // ─── Posts ───────────────────────────────────────────────────────────────
    // Any auth user can read, create, and update (likes / commentsCount).
    // Only the author or an admin can delete.
    match /posts/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ─── Post comments (subcollection) ───────────────────────────────────────
    // Any auth user can read and create.
    // Author or admin can update (edit) or delete.
    match /posts/{postId}/comments/{commentId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ─── Networks (connection system) ────────────────────────────────────────
    match /networks/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.fromUserId == request.auth.uid;
    }

    // ─── Reviews ─────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reviewerId == request.auth.uid;
    }

    // ─── OTPs (server-written, user-readable for verification) ───────────────
    match /otps/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Activity logs ───────────────────────────────────────────────────────
    // Any auth user can create a log entry (written by client actions).
    // Only admins can read logs (sensitive audit data).
    match /activityLogs/{logId} {
      allow create: if request.auth != null;
      allow read:   if isAdmin();
    }

    // ─── Default: deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

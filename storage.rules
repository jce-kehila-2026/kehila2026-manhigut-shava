rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuth()  { return request.auth != null; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isImageOrVideo() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*');
    }
    function underMB(n) { return request.resource.size < n * 1024 * 1024; }

    // Avatars — owner only; uploads must be images <= 5 MB
    match /avatars/{userId} {
      allow read:           if isAuth();
      allow create, update: if request.auth.uid == userId && isImage() && underMB(5);
      allow delete:         if request.auth.uid == userId;
    }

    // Cover photos — owner only; uploads must be images <= 8 MB
    match /covers/{userId} {
      allow read:           if isAuth();
      allow create, update: if request.auth.uid == userId && isImage() && underMB(8);
      allow delete:         if request.auth.uid == userId;
    }

    // Post media — images or videos, <= 50 MB
    match /posts/{fileName} {
      allow read:   if isAuth();
      allow create: if isAuth() && isImageOrVideo() && underMB(50);
      allow delete: if isAuth();
    }

    // Slideshow images — admin only (claim set by syncAdminClaim Cloud Function)
    match /slideshow/{fileName} {
      allow read:           if isAuth();
      allow create, update: if request.auth.token.isAdmin == true && isImage() && underMB(10);
      allow delete:         if request.auth.token.isAdmin == true;
    }

    // Chat image uploads — images <= 10 MB
    match /chat-images/{allPaths=**} {
      allow read:           if isAuth();
      allow create, update: if isAuth() && isImage() && underMB(10);
      allow delete:         if isAuth();
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
